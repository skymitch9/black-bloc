# Virtualenv + Python noise
.venv/
.venv-spike/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Secrets. The real bot token lives ONLY in .env (never committed) and in the
# Discord Developer Portal, which can re-mint it. See docs/access/setup.md.
.env
.env.*
!.env.example

# Runtime data. The SQLite DB and its WAL/SHM sidecars are state, not source.
data/*
!data/.gitkeep

# One-off read-only Discord scan scripts written by agents; scratch tooling, not product.
scripts/scan/

# Agent worktrees (parallel builders); never product code.
.claude/

# .env.enc (scripts/env-lock.sh) is NEVER committed — purged from history 2026-09-10 before the repo went public
.env.enc

# Gate logs written by a build run, never committed (only bot code goes in)
/gate.log
/gate-reverse.log
