# The local CI mirror's image (docs/access/ci-mirror.md); the bot's runtime image is ./Dockerfile.
FROM node:20-bookworm-slim AS node

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install --no-install-recommends -y libopus0 git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node /usr/local/bin/node /usr/local/bin/node

WORKDIR /work
COPY pyproject.toml README.md ./
RUN --mount=type=cache,target=/root/.cache/pip \
    mkdir black_bloc && touch black_bloc/__init__.py \
    && pip install -e ".[dev]" \
    && rm -rf black_bloc
