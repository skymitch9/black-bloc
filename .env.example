# Copy to .env and fill in. .env is gitignored. Names only in docs — never paste
# the token anywhere but here, the Discord Developer Portal, and `fly secrets`.

# Bot token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Guild (server) ID used for instant slash-command sync while developing.
# Leave blank for no dev sync (commands then need a global sync, which can take
# up to an hour to appear).
DEV_GUILD_ID=

# Legacy text-command prefix; slash commands are the primary surface.
COMMAND_PREFIX=!

LOG_LEVEL=INFO

# Where the SQLite database lives (relative to the working directory).
DATABASE_PATH=data/black_bloc.sqlite3

# Optional FastAPI companion server (health endpoint now; dashboard/webhooks
# later). Off by default; when on, it binds to localhost only.
API_ENABLED=false
API_HOST=127.0.0.1
API_PORT=8080

# The config website (site/). ONE origin serves the page and the API, so there
# is no CORS and no second hostname: SITE_ORIGIN is where sign-in returns to AND
# where this API answers, and it owns the OAuth redirect URI
# (<SITE_ORIGIN>/api/auth/callback), which must be registered in the Discord
# Developer Portal exactly. SITE_ROOT is the directory served at /.
# See docs/access/site.md.
SITE_ORIGIN=https://blackbloc.heygabi.ai
SITE_ROOT=site/public

# Discord OAuth2 for staff sign-in on the site: Developer Portal -> your app ->
# OAuth2. SESSION_SECRET signs the session cookie and must be at least 32
# characters — python -c "import secrets; print(secrets.token_urlsafe(48))";
# changing it signs everyone out. Values live in .env and `fly secrets`, never
# in docs. Sign-in stays off until all three are set and the secret is long
# enough. SESSION_COOKIE_SAMESITE is lax (the default) or strict, never none.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=

# The key that keeps an anonymous panel poll's votes anonymous: with it set, a
# vote is stored under HMAC-SHA256(key, poll:member) instead of a plain hash of
# the same two numbers, so the database alone can no longer confirm a guess at
# who voted. Optional — unset, new polls keep the old hash and the bot logs one
# warning at startup. Each poll remembers the scheme it was CREATED with, so
# setting or changing this never moves a poll that is already open; a poll made
# while it was set cannot be voted on if it is later removed. Make one with
# python -c "import secrets; print(secrets.token_urlsafe(48))" and keep it in
# `fly secrets` — losing it is the only thing that breaks a keyed poll.
POLL_VOTE_SECRET=

# Twitch developer app (dev.twitch.tv/console/apps). FALLBACK path for the
# go-live feed — Discord presence is primary. Optional until F1 uses EventSub.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# The two chat model tiers (Phase 14). BOTH are optional and BOTH default to
# unset: a blank key means that tier simply does not exist and the @-mention
# ladder carries on to the next rung, so nothing breaks without them. Nothing
# calls a model at all until `chat_llm_mode` is set to `on` as well — the key
# and the switch are deliberately two separate acts.
#   ANTHROPIC_API_KEY — console.anthropic.com, the IMPORTANT tier (Haiku 4.5).
#   GROQ_API_KEY      — console.groq.com, the SIMPLE tier (model is the
#                       `chat_simple_model` setting, not this file).
# Values live in .env and `fly secrets set NAME=... --app black-bloc`, never in
# docs and never in a log line.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Owner rule (2026-08-26): while TEST_MODE is true the bot refuses to send or
# answer commands anywhere except TEST_CHANNEL_ID and DMs (black_bloc/guard.py).
# Flip to false ONLY on the owner's say-so.
TEST_MODE=true
TEST_CHANNEL_ID=
