# Copy to .env and fill in. .env is gitignored. Names only in docs — never paste
# the token anywhere but here, the Discord Developer Portal, and `fly secrets`.

# Bot token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Guild (server) ID used for instant slash-command sync while developing.
# Leave blank for no dev sync (commands then need a global sync, which can take
# up to an hour to appear).
DEV_GUILD_ID=

# Legacy text-command prefix; slash commands are the primary surface.
COMMAND_PREFIX=!

LOG_LEVEL=INFO

# Where the SQLite database lives (relative to the working directory).
DATABASE_PATH=data/black_bloc.sqlite3

# Optional FastAPI companion server (health endpoint now; dashboard/webhooks
# later). Off by default; when on, it binds to localhost only.
API_ENABLED=false
API_HOST=127.0.0.1
API_PORT=8080

# Owner rule (2026-08-26): while TEST_MODE is true the bot refuses to send or
# answer commands anywhere except TEST_CHANNEL_ID and DMs (black_bloc/guard.py).
# Flip to false ONLY on the owner's say-so.
TEST_MODE=true
TEST_CHANNEL_ID=
